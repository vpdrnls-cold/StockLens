# Generated data
*.log

# Kiwoom raw API dumps (~3MB per stock per run, adds up at 50 stocks).
# ka10081 (daily) is regenerable, but ka10080 (minute) is NOT: the API only
# serves about the last year, so older minute bars exist only in this local
# copy -- back it up (scripts/nightly_ingest.sh, STOCKLENS_RAW_BACKUP_DIR).
data/raw/
# Derived datasets (regenerable with scripts/build_ml_dataset.py)
data/processed/*.csv
# Personal investor-profile answers (scripts/survey.py) -- never commit (public repo)
data/user_profile.json

# Saved experiment time series + figures (regenerable; see src/reporting/run_log.py)
reports/runs/

# Analyst cards (item 61): generated outputs
reports/analyst_cards/
data/processed/analysts/

