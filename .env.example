# Copy to .env and fill in real values. NEVER commit real credentials.
KIWOOM_APP_KEY=your-app-key
KIWOOM_SECRET_KEY=your-secret-key
KIWOOM_ACCOUNT_NO=your-account-number
KIWOOM_BASE_URL=https://api.kiwoom.com
KIWOOM_WS_URL=wss://api.kiwoom.com:10000

# Optional: the public IP registered in the matching Kiwoom App Key portal.
# Used only by `scripts/check_kiwoom_quote.py --diagnose` to compare it with
# the current public IP. It is not sent to Kiwoom.
KIWOOM_REGISTERED_IP=0.0.0.0

# External macro / disclosure sources (CURRENT_STATUS item 59). Free keys.
ECOS_API_KEY=your-ecos-key          # https://ecos.bok.or.kr/api/
FRED_API_KEY=your-fred-key          # https://fred.stlouisfed.org/docs/api/api_key.html
DART_API_KEY=your-opendart-key      # https://opendart.fss.or.kr/
# NAVER API HUB (search/news, item 75) -- issued in the NAVER Cloud Platform console, not the old Developers Center
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
